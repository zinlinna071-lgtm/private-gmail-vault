# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only key for encrypting saved account passwords and backup codes.
# Generate 32 cryptographically random bytes and encode as 64 hexadecimal characters.
# Keep this key separate from VAULT_ENCRYPTION_KEY and never commit its real value.
VAULT_DATA_ENCRYPTION_KEY=

# Server-only key for protecting pending Vault Recovery Codes.
# Generate 32 cryptographically random bytes and encode as 64 hexadecimal characters.
VAULT_ENCRYPTION_KEY=
