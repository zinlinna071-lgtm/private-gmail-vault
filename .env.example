# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy Vault key. Existing Gmail token version 1 ciphertext currently uses this key.
# Generate 32 cryptographically random bytes, encode as 64 hex characters.
VAULT_ENCRYPTION_KEY=

# Gmail token keyring. V1 must be exactly the same key material as VAULT_ENCRYPTION_KEY
# until all legacy version-1 ciphertext has been deliberately migrated.
# Add V2/V3 only when those keys have been securely provisioned.
GMAIL_TOKEN_ENCRYPTION_KEY_V1=
# GMAIL_TOKEN_ENCRYPTION_KEY_V2=
GMAIL_TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1
GMAIL_TOKEN_ENCRYPTION_ACTIVE_FORMAT_VERSION=1

# Separate server-only OAuth state HMAC key (64 hex characters / 32 random bytes).
# Do not reuse the Gmail token encryption key.
GMAIL_OAUTH_STATE_HMAC_KEY=

# Google OAuth credentials (needed for the Gmail connection stage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
