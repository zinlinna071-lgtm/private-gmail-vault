# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Generate a 32-byte key and store only in the deployment secret manager.
VAULT_ENCRYPTION_KEY=

# Google OAuth credentials (needed for the Gmail connection stage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
