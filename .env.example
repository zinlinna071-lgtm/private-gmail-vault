# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only key for encrypting saved account passwords and backup codes.
# Generate 32 cryptographically random bytes and encode as 64 hexadecimal characters.
# Keep this key separate from VAULT_ENCRYPTION_KEY and never commit its real value.
VAULT_DATA_ENCRYPTION_KEY=

# Server-only key for protecting pending Vault Recovery Codes.
# Generate 32 cryptographically random bytes and encode as 64 hexadecimal characters.
VAULT_ENCRYPTION_KEY=

# GitHub Actions webhook ingestion is disabled unless explicitly enabled.
# Keep this secret server-only. Generate at least 32 random bytes; never use NEXT_PUBLIC_.
GITHUB_WEBHOOK_INGESTION_ENABLED=false
GITHUB_WEBHOOK_SECRET=

# Server-only fine-grained GitHub token with Actions: read-only for this repository.
# Required for canonical workflow/run/job re-fetch; never use NEXT_PUBLIC_.
GITHUB_API_TOKEN=
