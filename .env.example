# Supabase project settings (server-side and public URL only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Generate a 32-byte key and store it only in the deployment secret manager.
# Do not commit a real value.
VAULT_ENCRYPTION_KEY=

# Google OAuth credentials (configure after creating the Google Cloud project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
