# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Generate 32 cryptographically random bytes, encode as 64 hex characters,
# and store only in the deployment secret manager. Never rotate without re-encrypting pending data.
VAULT_ENCRYPTION_KEY=

# Google OAuth credentials (needed for the Gmail connection stage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
